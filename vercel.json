{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "demo",
  "cleanUrls": true,
  "functions": {
    "api/predict.py": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": [
        "artifacts/experiments/RESIDUAL-COPYMOVE-001/best.pt"
      ],
      "excludeFiles": "{tests/**,reports/**,docs/**,cloud/**,configs/**,scripts/**,tools/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/predict"
    }
  ]
}
