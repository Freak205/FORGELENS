{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "demo",
  "cleanUrls": true,
  "functions": {
    "api/predict.py": {
      "maxDuration": 300,
      "includeFiles": "api/model.onnx",
      "excludeFiles": "{.git/**,.venv/**,.cache/**,artifacts/**,checkpoints/**,cloud/**,configs/**,data/**,demo/**,docs/**,notebooks/**,outputs/**,reports/**,results/**,scripts/**,src/**,tests/**,tools/**,*.md,*.cff,LICENSE,pyproject.toml,uv.lock,vercel.json,.vercelignore}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/predict"
    }
  ]
}
